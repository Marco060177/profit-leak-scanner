// This is your Prisma schema file.
// Learn more about it in the Prisma documentation: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ChannelPlatform {
  SHOPIFY
  AMAZON
}

model Account {
  id                 String              @id @default(cuid())
  status             String              @default("ACTIVE")
  deletionRequestedAt DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  channelConnections ChannelConnection[]
  legacyShopMappings LegacyShopMapping[]
  aiUsage            AccountAiUsage[]
  aiUsageReservations AccountAiUsageReservation[]
  notificationPreferences NotificationPreferences?
  notificationDeliveries NotificationDelivery[]
  marketplaces Marketplace[]
  products Product[]
  skus Sku[]
  channelListings ChannelListing[]
  productMappingCandidates ProductMappingCandidate[]
  productMappingDecisions ProductMappingDecision[]
  syncRuns SyncRun[]
  rawSourceRecords RawSourceRecord[]
  normalizedOrders NormalizedOrder[]

  @@index([status])
}

model AccountAiUsage {
  id        String   @id @default(cuid())
  accountId String
  periodKey String
  requests  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([accountId, periodKey])
}

model AccountAiUsageReservation {
  id                  String   @id @default(cuid())
  accountId           String
  periodKey           String
  status              String   @default("RESERVED")
  legacyShadowApplied Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  account             Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, periodKey])
}

model ChannelConnection {
  FinancialComponentSelection_ownerChannel FinancialComponentSelection[] @relation("FinancialComponentSelection_ownerChannel")
  FinancialAuthorityDecision_ownerChannel FinancialAuthorityDecision[] @relation("FinancialAuthorityDecision_ownerChannel")
  FinancialAuthorityEvidenceMember_ownerChannel FinancialAuthorityEvidenceMember[] @relation("FinancialAuthorityEvidenceMember_ownerChannel")
  FinancialAuthorityEvidenceSource_ownerChannel FinancialAuthorityEvidenceSource[] @relation("FinancialAuthorityEvidenceSource_ownerChannel")
  FinancialAuthorityEvidence_ownerChannel FinancialAuthorityEvidence[] @relation("FinancialAuthorityEvidence_ownerChannel")
  FinancialLedgerEntry_ownerChannel FinancialLedgerEntry[] @relation("FinancialLedgerEntry_ownerChannel")
  FinancialComponentHead_ownerChannel FinancialComponentHead[] @relation("FinancialComponentHead_ownerChannel")
  FinancialAuthorityBinding_ownerChannel FinancialAuthorityBinding[] @relation("FinancialAuthorityBinding_ownerChannel")
  FinancialAuthorityScope_ownerChannel FinancialAuthorityScope[] @relation("FinancialAuthorityScope_ownerChannel")
  id                 String             @id @default(cuid())
  accountId          String
  channel            ChannelPlatform
  externalAccountId  String
  status             String             @default("ACTIVE")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  account            Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  legacyShopMapping  LegacyShopMapping?
  storeTaxProfiles   StoreTaxProfile[]
  profitAssumptions  ProfitAssumptions[]
  profitMonitorSnapshots ProfitMonitorSnapshot[]
  profitMonitorAlerts   ProfitMonitorAlert[]
  profitImpactActions   ProfitImpactAction[]
  notificationDeliveries NotificationDelivery[]
  marketplaces Marketplace[]
  channelListings ChannelListing[]
  syncRuns SyncRun[]
  rawSourceRecords RawSourceRecord[]
  normalizedOrders NormalizedOrder[]
  syncCheckpoints SyncCheckpoint[]
  dataCoverages DataCoverage[]
  coreAuthorization CoreChannelAuthorization?

  @@unique([channel, externalAccountId])
  @@unique([id, accountId])
  @@index([accountId])
}

/** D1 sync authorization epoch; no Shopify runtime path reads this yet. */
model CoreChannelAuthorization {
  channelConnectionId String @id
  accountId String
  authorizationVersion String
  updatedAt DateTime @updatedAt
  channelConnection ChannelConnection @relation(fields: [channelConnectionId, accountId], references: [id, accountId], onDelete: Restrict)
  @@unique([channelConnectionId, accountId])
  @@index([accountId])
}

model LegacyShopMapping {
  shopDomain          String            @id
  accountId           String
  channelConnectionId String            @unique
  createdAt           DateTime          @default(now())
  account             Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  channelConnection   ChannelConnection @relation(fields: [channelConnectionId, accountId], references: [id, accountId], onDelete: Cascade)

  @@unique([channelConnectionId, accountId])
  @@index([accountId])
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model ProfitAssumptions {
  id                String   @id @default(cuid())
  shop              String   @unique
  channelConnectionId String?
  channelConnection   ChannelConnection? @relation(fields: [channelConnectionId], references: [id], onDelete: Restrict)
  monthlyAds        Float    @default(0)
  monthlyShipping   Float    @default(0)
  monthlyOperating  Float    @default(0)
  paymentFeePct     Float    @default(0)
  transactionFeePct Float    @default(0)
  taxReservePct     Float    @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([channelConnectionId])
}

model AiUsage {
  id        String   @id @default(cuid())
  shop      String
  month     String
  requests  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shop, month])
}

model ProfitMonitorSnapshot {
  id          String   @id @default(cuid())
  shop        String
  channelConnectionId String?
  channelConnection   ChannelConnection? @relation(fields: [channelConnectionId], references: [id], onDelete: Restrict)
  periodDays  Int
  fingerprint String
  payloadJson String
  capturedAt  DateTime @default(now())

  @@unique([shop, periodDays, fingerprint])
  @@index([shop, periodDays, capturedAt])
  @@index([channelConnectionId])
}

model ProfitMonitorAlert {
  id                String                    @id @default(cuid())
  shop              String
  channelConnectionId String?
  channelConnection   ChannelConnection? @relation(fields: [channelConnectionId], references: [id], onDelete: Restrict)
  periodDays        Int
  alertKey          String
  alertType         String
  productId         String?
  status            String                    @default("new")
  isRead            Boolean                   @default(false)
  severity          String
  category          String
  title             String
  description       String
  monthlyImpact     Float                     @default(0)
  economicKind      String
  priority          Int                       @default(0)
  actionLabel       String
  route             String
  businessAction    String
  effort            String
  estimatedMinutes  Int                       @default(0)
  recommendedModule String
  productTitle      String?
  metadataJson      String?
  firstSeenAt       DateTime                  @default(now())
  lastSeenAt        DateTime                  @default(now())
  acknowledgedAt    DateTime?
  resolvedAt        DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  events            ProfitMonitorAlertEvent[]

  @@unique([shop, periodDays, alertKey])
  @@index([shop, periodDays, status])
  @@index([channelConnectionId])
}

model ProfitMonitorAlertEvent {
  id         String             @id @default(cuid())
  alertId    String
  fromStatus String?
  toStatus   String
  source     String
  createdAt  DateTime           @default(now())
  alert      ProfitMonitorAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([alertId, createdAt])
}

model StoreTaxProfile {
  id                   String   @id @default(cuid())
  shop                 String   @unique
  channelConnectionId  String?
  channelConnection    ChannelConnection? @relation(fields: [channelConnectionId], references: [id], onDelete: Restrict)
  countryCode          String
  regime               String   @default("UNCONFIGURED")

  defaultVatRatePct     Float    @default(22)

  pricesIncludeVat      Boolean  @default(true)
  costsIncludeVat       Boolean  @default(true)
  recoverInputVat       Boolean  @default(true)
  inputVatRecoveryPct   Float    @default(100)

  shippingIncludeVat    Boolean  @default(true)
  shippingVatRatePct    Float    @default(22)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([channelConnectionId])
}

model NotificationPreferences {
  id                     String   @id @default(cuid())
  shop                   String?  @unique
  accountId              String?  @unique
  account                Account? @relation(fields: [accountId], references: [id], onDelete: Restrict)

  recipientEmail         String?

  emailAlertsEnabled     Boolean  @default(false)
  weeklyReportEnabled    Boolean  @default(false)

  notifyCritical         Boolean  @default(true)
  notifyWarnings         Boolean  @default(false)
  notifyOpportunities    Boolean  @default(false)

  weeklyReportDay        Int      @default(1)
  weeklyReportHour       Int      @default(8)

  timezone               String   @default("UTC")
  language               String   @default("en")

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model NotificationDelivery {
  id                 String   @id @default(cuid())
  shop               String?
  accountId          String?
  channelConnectionId String?
  account            Account? @relation(fields: [accountId], references: [id], onDelete: Restrict)
  channelConnection  ChannelConnection? @relation(fields: [channelConnectionId, accountId], references: [id, accountId], onDelete: Restrict)

  channel            String   @default("email")
  notificationType   String

  recipient          String

  alertKey           String?
  periodDays         Int?

  deduplicationKey   String   @unique

  subject            String?
  payloadJson        String?

  status             String   @default("pending")
  providerMessageId  String?
  errorMessage       String?

  scheduledFor       DateTime?
  sentAt             DateTime?
  failedAt           DateTime?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([shop, notificationType, createdAt])
  @@index([shop, status])
  @@index([scheduledFor, status])
  @@index([accountId, notificationType, createdAt])
  @@index([channelConnectionId])
}

model ProfitImpactAction {
  id                     String                    @id @default(cuid())
  shop                   String
  channelConnectionId    String?
  channelConnection      ChannelConnection? @relation(fields: [channelConnectionId], references: [id], onDelete: Restrict)
  idempotencyKey         String
  measuringProductKey    String?
  measurementClaimType   String?
  measurementClaimedAt  DateTime?
  actionType             String
  status                 String                    @default("ACCEPTED")
  sourceModule           String
  sourceAlertKey         String?
  productId              String?
  productTitle           String?
  title                  String
  changeDescription      String
  currencyCode           String
  measurementWindowDays  Int                       @default(14)
  appliedAt              DateTime?
  measurementStart       DateTime?
  measurementEnd         DateTime?
  completedAt            DateTime?
  cancelledAt            DateTime?
  previousValue          Float?
  appliedValue           Float?
  targetMetric           String?
  targetValue            Float?
  notes                  String?
  metadataJson           String?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  measurements           ProfitImpactMeasurement[]
  events                 ProfitImpactEvent[]

  @@index([shop, status, createdAt])
  @@index([shop, productId, status])
  @@index([shop, sourceAlertKey])
  @@index([channelConnectionId])
  @@unique([shop, idempotencyKey])
  @@unique([shop, measuringProductKey])
}

model ProfitImpactMeasurement {
  id                          String             @id @default(cuid())
  actionId                    String
  measurementType             String
  windowStart                 DateTime
  windowEnd                   DateTime
  observedDays                Int
  revenue                     Float
  economicProfit              Float
  economicMarginPct           Float
  units                       Float
  cogs                        Float
  discounts                   Float
  refunds                     Float
  averageUnitRevenue          Float?
  averageUnitCost             Float?
  discountRatePct             Float?
  measuredProfitChange        Float?
  measuredMarginChange        Float?
  measuredRevenueChange       Float?
  measuredUnitsChange         Float?
  measuredCogsChange          Float?
  estimatedAttributableImpact Float?
  attributionMethod           String?
  dataConfidenceScore         Int                @default(0)
  attributionConfidenceScore  Int?
  confidenceLevel             String             @default("LOW")
  confidenceReasonsJson       String?
  sourceCompletenessJson      String?
  capturedAt                  DateTime           @default(now())
  action                      ProfitImpactAction @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@unique([actionId, measurementType])
  @@index([actionId, capturedAt])
}

model ProfitImpactEvent {
  id         String             @id @default(cuid())
  actionId   String
  fromStatus String?
  toStatus   String
  source     String
  note       String?
  createdAt  DateTime           @default(now())
  action     ProfitImpactAction @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@index([actionId, createdAt])
}

// D1 persisted Data Core foundation. Shopify runtime does not read these tables.
model Marketplace {
  FinancialAuthorityScope_marketplace FinancialAuthorityScope[] @relation("FinancialAuthorityScope_marketplace")
  id String @id @default(cuid())
  accountId String
  channelConnectionId String
  externalMarketplaceId String
  countryCode String?
  currencyCode String?
  status String @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  channelConnection ChannelConnection @relation(fields: [channelConnectionId, accountId], references: [id, accountId], onDelete: Restrict)
  channelListings ChannelListing[]
  syncSlices SyncSlice[]
  syncCheckpoints SyncCheckpoint[]
  dataCoverages DataCoverage[]
  normalizedOrders NormalizedOrder[]
  @@unique([channelConnectionId, externalMarketplaceId])
  @@unique([id, accountId, channelConnectionId])
  @@index([accountId])
}

model Product {
  id String @id @default(cuid())
  accountId String
  title String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  skus Sku[]
  @@unique([id, accountId])
  @@index([accountId])
}

model Sku {
  id String @id @default(cuid())
  accountId String
  productId String?
  sellerSku String?
  barcode String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  product Product? @relation(fields: [productId, accountId], references: [id, accountId], onDelete: Restrict)
  listings ChannelListing[]
  mappingCandidates ProductMappingCandidate[]
  normalizedOrderItemRevisions NormalizedOrderItemRevision[]
  @@unique([id, accountId])
  @@index([accountId, sellerSku])
  @@index([productId])
}

model ChannelListing {
  id String @id @default(cuid())
  accountId String
  channelConnectionId String
  marketplaceId String?
  marketplaceScopeKey String
  sourceEntityType String
  externalProductId String?
  externalVariantOrListingId String
  skuId String?
  state String @default("ACTIVE")
  metadataJson String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  channelConnection ChannelConnection @relation(fields: [channelConnectionId, accountId], references: [id, accountId], onDelete: Restrict)
  marketplace Marketplace? @relation(fields: [marketplaceId, accountId, channelConnectionId], references: [id, accountId, channelConnectionId], onDelete: Restrict)
  sku Sku? @relation(fields: [skuId, accountId], references: [id, accountId], onDelete: Restrict)
  mappingCandidates ProductMappingCandidate[]
  normalizedOrderItemRevisions NormalizedOrderItemRevision[]
  @@unique([channelConnectionId, marketplaceScopeKey, sourceEntityType, externalVariantOrListingId])
  @@unique([id, accountId])
  @@unique([id, accountId, channelConnectionId, marketplaceScopeKey])
  @@index([accountId, skuId])
}

model ProductMappingCandidate {
  id String @id @default(cuid())
  accountId String
  listingId String
  candidateSkuId String
  ruleVersion String
  confidence Int
  state String @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  listing ChannelListing @relation(fields: [listingId, accountId], references: [id, accountId], onDelete: Restrict)
  sku Sku @relation(fields: [candidateSkuId, accountId], references: [id, accountId], onDelete: Restrict)
  decisions ProductMappingDecision[]
  @@unique([listingId, candidateSkuId, ruleVersion])
  @@unique([id, accountId])
  @@index([accountId, state])
}

model ProductMappingDecision {
  id String @id @default(cuid())
  accountId String
  candidateId String
  decision String
  actorRef String
  createdAt DateTime @default(now())
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  candidate ProductMappingCandidate @relation(fields: [candidateId, accountId], references: [id, accountId], onDelete: Restrict)
  normalizedOrderItemRevisions NormalizedOrderItemRevision[]
  @@unique([id, accountId])
  @@index([candidateId, createdAt])
}

model CurrencyPolicyVersion {
  id String @id @default(cuid())
  version String @unique
  checksum String
  exponentSourceVersion String
  roundingMode String
  toleranceAtoms BigInt
  toleranceScale Int
  residualPolicy String
  activatedAt DateTime?
  deactivatedAt DateTime?
  createdAt DateTime @default(now())
}

model MappingVersion {
  FinancialAuthorityDecision_mapping FinancialAuthorityDecision[] @relation("FinancialAuthorityDecision_mapping")
  FinancialAuthorityEvidenceSource_mapping FinancialAuthorityEvidenceSource[] @relation("FinancialAuthorityEvidenceSource_mapping")
  FinancialAuthorityEvidence_mapping FinancialAuthorityEvidence[] @relation("FinancialAuthorityEvidence_mapping")
  FinancialLedgerEntry_mapping FinancialLedgerEntry[] @relation("FinancialLedgerEntry_mapping")
  FinancialAuthorityBinding_mapping FinancialAuthorityBinding[] @relation("FinancialAuthorityBinding_mapping")
  FinancialAuthorityScope_policy FinancialAuthorityScope[] @relation("FinancialAuthorityScope_policy")
  id String @id @default(cuid())
  platform ChannelPlatform
  sourceContract String
  sourceVersion String
  mapperSemanticVersion String
  formulaCompatibilityVersion String
  checksum String
  activatedAt DateTime?
  deactivatedAt DateTime?
  createdAt DateTime @default(now())
  syncRuns SyncRun[]
  normalizationRuns NormalizationRun[]
  normalizedOrderRevisions NormalizedOrderRevision[]
  normalizedOrderItemRevisions NormalizedOrderItemRevision[]
  syncCheckpoints SyncCheckpoint[]
  @@unique([platform, sourceContract, sourceVersion, mapperSemanticVersion])
}

model SyncRun {
  id String @id @default(cuid())
  accountId String
  channelConnectionId String
  stream String
  authorizationVersion String
  mappingVersionId String
  status String @default("PENDING")
  attempt Int @default(0)
  createdAt DateTime @default(now())
  startedAt DateTime?
  finishedAt DateTime?
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  channelConnection ChannelConnection @relation(fields: [channelConnectionId, accountId], references: [id, accountId], onDelete: Restrict)
  mappingVersion MappingVersion @relation(fields: [mappingVersionId], references: [id], onDelete: Restrict)
  rawSourceRecords RawSourceRecord[]
  slices SyncSlice[]
  @@unique([id, accountId, channelConnectionId])
  @@index([channelConnectionId, stream, status])
}

model RawSourceRecord {
  FinancialAuthorityEvidenceSource_raw FinancialAuthorityEvidenceSource[] @relation("FinancialAuthorityEvidenceSource_raw")
  FinancialLedgerEntry_raw FinancialLedgerEntry[] @relation("FinancialLedgerEntry_raw")
  FinancialAuthorityBinding_raw FinancialAuthorityBinding[] @relation("FinancialAuthorityBinding_raw")
  id String @id @default(cuid())
  accountId String
  channelConnectionId String
  sourceSystem String
  sourceVersion String
  sourceEntityType String
  sourceEntityId String
  sourceSnapshotVersion String?
  capturedAt DateTime
  sourceUpdatedAt DateTime?
  schemaVersion String
  payloadChecksum String
  payloadByteLength Int
  retentionClass String
  expiresAt DateTime?
  ingestionRunId String?
  payloadStorageMode String @default("DB_CHUNKS")
  createdAt DateTime @default(now())
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  channelConnection ChannelConnection @relation(fields: [channelConnectionId, accountId], references: [id, accountId], onDelete: Restrict)
  ingestionRun SyncRun? @relation(fields: [ingestionRunId, accountId, channelConnectionId], references: [id, accountId, channelConnectionId], onDelete: Restrict)
  chunks RawSourceBlobChunk[]
  references SourceReference[]
  normalizationRuns NormalizationRun[]
  sliceEvidence SyncSliceEvidence[]
  normalizedOrderRevisions NormalizedOrderRevision[]
  normalizedOrderItemRevisions NormalizedOrderItemRevision[]
  @@unique([channelConnectionId, sourceSystem, sourceVersion, sourceEntityType, sourceEntityId, payloadChecksum])
  @@unique([id, accountId, channelConnectionId])
  @@unique([id, accountId, channelConnectionId, ingestionRunId])
  @@index([accountId, capturedAt])
}

model RawSourceBlobChunk {
  id String @id @default(cuid())
  accountId String
  channelConnectionId String
  rawSourceRecordId String
  chunkIndex Int
  encryptedBytes Bytes
  rawSourceRecord RawSourceRecord @relation(fields: [rawSourceRecordId, accountId, channelConnectionId], references: [id, accountId, channelConnectionId], onDelete: Restrict)
  @@unique([rawSourceRecordId, chunkIndex])
}

model SourceReference {
  id String @id @default(cuid())
  accountId String
  channelConnectionId String
  rawSourceRecordId String
  sourceLeafPath String
  targetKind String
  targetKey String
  createdAt DateTime @default(now())
  rawSourceRecord RawSourceRecord @relation(fields: [rawSourceRecordId, accountId, channelConnectionId], references: [id, accountId, channelConnectionId], onDelete: Restrict)
  @@unique([rawSourceRecordId, sourceLeafPath, targetKind, targetKey])
  @@index([accountId, targetKind, targetKey])
}

model NormalizationRun {
  FinancialAuthorityEvidenceSource_normalization FinancialAuthorityEvidenceSource[] @relation("FinancialAuthorityEvidenceSource_normalization")
  FinancialLedgerEntry_normalization FinancialLedgerEntry[] @relation("FinancialLedgerEntry_normalization")
  FinancialAuthorityBinding_normalization FinancialAuthorityBinding[] @relation("FinancialAuthorityBinding_normalization")
  id String @id @default(cuid())
  accountId String
  channelConnectionId String
  rawSourceRecordId String
  mappingVersionId String
  parserVersion String
  normalizationRevision Int
  status String @default("PENDING")
  safeErrorCode String?
  createdAt DateTime @default(now())
  finishedAt DateTime?
  rawSourceRecord RawSourceRecord @relation(fields: [rawSourceRecordId, accountId, channelConnectionId], references: [id, accountId, channelConnectionId], onDelete: Restrict)
  mappingVersion MappingVersion @relation(fields: [mappingVersionId], references: [id], onDelete: Restrict)
  sliceEvidence SyncSliceEvidence[]
  normalizedOrderRevisions NormalizedOrderRevision[]
  normalizedOrderItemRevisions NormalizedOrderItemRevision[]
  @@unique([rawSourceRecordId, mappingVersionId, normalizationRevision])
  @@unique([id, accountId, channelConnectionId, rawSourceRecordId])
  @@unique([id, accountId, channelConnectionId, rawSourceRecordId, mappingVersionId, normalizationRevision])
  @@index([accountId, status])
}

model NormalizedOrder {
  FinancialLedgerEntry_orderIdRow FinancialLedgerEntry[] @relation("FinancialLedgerEntry_orderIdRow")
  id String @id @default(cuid())
  accountId String
  channelConnectionId String
  marketplaceId String?
  marketplaceScopeKey String
  sourceSystem String
  sourceOrderKey String
  createdAt DateTime @default(now())
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  channelConnection ChannelConnection @relation(fields: [channelConnectionId, accountId], references: [id, accountId], onDelete: Restrict)
  marketplace Marketplace? @relation(fields: [marketplaceId, accountId, channelConnectionId], references: [id, accountId, channelConnectionId], onDelete: Restrict)
  revisions NormalizedOrderRevision[]
  items NormalizedOrderItem[]
  @@unique([channelConnectionId, marketplaceScopeKey, sourceSystem, sourceOrderKey])
  @@unique([id, accountId, channelConnectionId])
  @@unique([id, accountId, channelConnectionId, marketplaceScopeKey])
  @@index([accountId])
}

model NormalizedOrderRevision {
  FinancialLedgerEntry_orderRevisionIdRow FinancialLedgerEntry[] @relation("FinancialLedgerEntry_orderRevisionIdRow")
  id String @id @default(cuid())
  accountId String
  channelConnectionId String
  orderId String
  revision Int
  operationKey String
  inputChecksum String
  normalizedStatus String
  sourceStatus String?
  occurredAt DateTime?
  postedAt DateTime?
  rawSourceRecordId String
  normalizationRunId String
  mappingVersionId String
  normalizationRevision Int
  syncSliceEvidenceId String
  createdAt DateTime @default(now())
  order NormalizedOrder @relation(fields: [orderId, accountId, channelConnectionId], references: [id, accountId, channelConnectionId], onDelete: Restrict)
  rawSourceRecord RawSourceRecord @relation(fields: [rawSourceRecordId, accountId, channelConnectionId], references: [id, accountId, channelConnectionId], onDelete: Restrict)
  normalizationRun NormalizationRun @relation(fields: [normalizationRunId, accountId, channelConnectionId, rawSourceRecordId, mappingVersionId, normalizationRevision], references: [id, accountId, channelConnectionId, rawSourceRecordId, mappingVersionId, normalizationRevision], onDelete: Restrict)
  mappingVersion MappingVersion @relation(fields: [mappingVersionId], references: [id], onDelete: Restrict)
  syncSliceEvidence SyncSliceEvidence @relation(fields: [syncSliceEvidenceId, accountId, channelConnectionId, rawSourceRecordId, normalizationRunId], references: [id, accountId, channelConnectionId, rawSourceRecordId, normalizationRunId], onDelete: Restrict)
  @@unique([orderId, revision])
  @@unique([orderId, operationKey])
  @@index([accountId, channelConnectionId])
}

model NormalizedOrderItem {
  FinancialLedgerEntry_itemIdRow FinancialLedgerEntry[] @relation("FinancialLedgerEntry_itemIdRow")
  id String @id @default(cuid())
  accountId String
  channelConnectionId String
  orderId String
  sourceItemKey String
  createdAt DateTime @default(now())
  order NormalizedOrder @relation(fields: [orderId, accountId, channelConnectionId], references: [id, accountId, channelConnectionId], onDelete: Restrict)
  revisions NormalizedOrderItemRevision[]
  @@unique([orderId, sourceItemKey])
  @@unique([id, accountId, channelConnectionId])
  @@index([accountId, channelConnectionId])
}

model NormalizedOrderItemRevision {
