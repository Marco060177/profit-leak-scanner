// This is your Prisma schema file.
// Learn more about it in the Prisma documentation: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ChannelPlatform {
  SHOPIFY
  AMAZON
}

model Account {
  id                 String              @id @default(cuid())
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  channelConnections ChannelConnection[]
  legacyShopMappings LegacyShopMapping[]
}

model ChannelConnection {
  id                 String             @id @default(cuid())
  accountId          String
  channel            ChannelPlatform
  externalAccountId  String
  status             String             @default("ACTIVE")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  account            Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  legacyShopMapping  LegacyShopMapping?
  storeTaxProfiles   StoreTaxProfile[]
  profitAssumptions  ProfitAssumptions[]
  profitMonitorSnapshots ProfitMonitorSnapshot[]
  profitMonitorAlerts   ProfitMonitorAlert[]

  @@unique([channel, externalAccountId])
  @@unique([id, accountId])
  @@index([accountId])
}

model LegacyShopMapping {
  shopDomain          String            @id
  accountId           String
  channelConnectionId String            @unique
  createdAt           DateTime          @default(now())
  account             Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  channelConnection   ChannelConnection @relation(fields: [channelConnectionId, accountId], references: [id, accountId], onDelete: Cascade)

  @@unique([channelConnectionId, accountId])
  @@index([accountId])
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model ProfitAssumptions {
  id                String   @id @default(cuid())
  shop              String   @unique
  channelConnectionId String?
  channelConnection   ChannelConnection? @relation(fields: [channelConnectionId], references: [id], onDelete: Restrict)
  monthlyAds        Float    @default(0)
  monthlyShipping   Float    @default(0)
  monthlyOperating  Float    @default(0)
  paymentFeePct     Float    @default(0)
  transactionFeePct Float    @default(0)
  taxReservePct     Float    @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([channelConnectionId])
}

model AiUsage {
  id        String   @id @default(cuid())
  shop      String
  month     String
  requests  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shop, month])
}

model ProfitMonitorSnapshot {
  id          String   @id @default(cuid())
  shop        String
  channelConnectionId String?
  channelConnection   ChannelConnection? @relation(fields: [channelConnectionId], references: [id], onDelete: Restrict)
  periodDays  Int
  fingerprint String
  payloadJson String
  capturedAt  DateTime @default(now())

  @@unique([shop, periodDays, fingerprint])
  @@index([shop, periodDays, capturedAt])
  @@index([channelConnectionId])
}

model ProfitMonitorAlert {
  id                String                    @id @default(cuid())
  shop              String
  channelConnectionId String?
  channelConnection   ChannelConnection? @relation(fields: [channelConnectionId], references: [id], onDelete: Restrict)
  periodDays        Int
  alertKey          String
  alertType         String
  productId         String?
  status            String                    @default("new")
  isRead            Boolean                   @default(false)
  severity          String
  category          String
  title             String
  description       String
  monthlyImpact     Float                     @default(0)
  economicKind      String
  priority          Int                       @default(0)
  actionLabel       String
  route             String
  businessAction    String
  effort            String
  estimatedMinutes  Int                       @default(0)
  recommendedModule String
  productTitle      String?
  metadataJson      String?
  firstSeenAt       DateTime                  @default(now())
  lastSeenAt        DateTime                  @default(now())
  acknowledgedAt    DateTime?
  resolvedAt        DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  events            ProfitMonitorAlertEvent[]

  @@unique([shop, periodDays, alertKey])
  @@index([shop, periodDays, status])
  @@index([channelConnectionId])
}

model ProfitMonitorAlertEvent {
  id         String             @id @default(cuid())
  alertId    String
  fromStatus String?
  toStatus   String
  source     String
  createdAt  DateTime           @default(now())
  alert      ProfitMonitorAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([alertId, createdAt])
}

model StoreTaxProfile {
  id                   String   @id @default(cuid())
  shop                 String   @unique
  channelConnectionId  String?
  channelConnection    ChannelConnection? @relation(fields: [channelConnectionId], references: [id], onDelete: Restrict)
  countryCode          String
  regime               String   @default("UNCONFIGURED")

  defaultVatRatePct     Float    @default(22)

  pricesIncludeVat      Boolean  @default(true)
  costsIncludeVat       Boolean  @default(true)
  recoverInputVat       Boolean  @default(true)
  inputVatRecoveryPct   Float    @default(100)

  shippingIncludeVat    Boolean  @default(true)
  shippingVatRatePct    Float    @default(22)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([channelConnectionId])
}

model NotificationPreferences {
  id                     String   @id @default(cuid())
  shop                   String   @unique

  recipientEmail         String?

  emailAlertsEnabled     Boolean  @default(false)
  weeklyReportEnabled    Boolean  @default(false)

  notifyCritical         Boolean  @default(true)
  notifyWarnings         Boolean  @default(false)
  notifyOpportunities    Boolean  @default(false)

  weeklyReportDay        Int      @default(1)
  weeklyReportHour       Int      @default(8)

  timezone               String   @default("UTC")
  language               String   @default("en")

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model NotificationDelivery {
  id                 String   @id @default(cuid())
  shop               String

  channel            String   @default("email")
  notificationType   String

  recipient          String

  alertKey           String?
  periodDays         Int?

  deduplicationKey   String   @unique

  subject            String?
  payloadJson        String?

  status             String   @default("pending")
  providerMessageId  String?
  errorMessage       String?

  scheduledFor       DateTime?
  sentAt             DateTime?
  failedAt           DateTime?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([shop, notificationType, createdAt])
  @@index([shop, status])
  @@index([scheduledFor, status])
}

model ProfitImpactAction {
  id                     String                    @id @default(cuid())
  shop                   String
  idempotencyKey         String
  measuringProductKey    String?
  measurementClaimType   String?
  measurementClaimedAt  DateTime?
  actionType             String
  status                 String                    @default("ACCEPTED")
  sourceModule           String
  sourceAlertKey         String?
  productId              String?
  productTitle           String?
  title                  String
  changeDescription      String
  currencyCode           String
  measurementWindowDays  Int                       @default(14)
  appliedAt              DateTime?
  measurementStart       DateTime?
  measurementEnd         DateTime?
  completedAt            DateTime?
  cancelledAt            DateTime?
  previousValue          Float?
  appliedValue           Float?
  targetMetric           String?
  targetValue            Float?
  notes                  String?
  metadataJson           String?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  measurements           ProfitImpactMeasurement[]
  events                 ProfitImpactEvent[]

  @@index([shop, status, createdAt])
  @@index([shop, productId, status])
  @@index([shop, sourceAlertKey])
  @@unique([shop, idempotencyKey])
  @@unique([shop, measuringProductKey])
}

model ProfitImpactMeasurement {
  id                          String             @id @default(cuid())
  actionId                    String
  measurementType             String
  windowStart                 DateTime
  windowEnd                   DateTime
  observedDays                Int
  revenue                     Float
  economicProfit              Float
  economicMarginPct           Float
  units                       Float
  cogs                        Float
  discounts                   Float
  refunds                     Float
  averageUnitRevenue          Float?
  averageUnitCost             Float?
  discountRatePct             Float?
  measuredProfitChange        Float?
  measuredMarginChange        Float?
  measuredRevenueChange       Float?
  measuredUnitsChange         Float?
  measuredCogsChange          Float?
  estimatedAttributableImpact Float?
  attributionMethod           String?
  dataConfidenceScore         Int                @default(0)
  attributionConfidenceScore  Int?
  confidenceLevel             String             @default("LOW")
  confidenceReasonsJson       String?
  sourceCompletenessJson      String?
  capturedAt                  DateTime           @default(now())
  action                      ProfitImpactAction @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@unique([actionId, measurementType])
  @@index([actionId, capturedAt])
}

model ProfitImpactEvent {
  id         String             @id @default(cuid())
  actionId   String
  fromStatus String?
  toStatus   String
  source     String
  note       String?
  createdAt  DateTime           @default(now())
  action     ProfitImpactAction @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@index([actionId, createdAt])
}
