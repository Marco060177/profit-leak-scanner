// This is your Prisma schema file.
// Learn more about it in the Prisma documentation: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model ProfitAssumptions {
  id                String   @id @default(cuid())
  shop              String   @unique
  monthlyAds        Float    @default(0)
  monthlyShipping   Float    @default(0)
  monthlyOperating  Float    @default(0)
  paymentFeePct     Float    @default(0)
  transactionFeePct Float    @default(0)
  taxReservePct     Float    @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model AiUsage {
  id        String   @id @default(cuid())
  shop      String
  month     String
  requests  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shop, month])
}

model ProfitMonitorSnapshot {
  id          String   @id @default(cuid())
  shop        String
  periodDays  Int
  fingerprint String
  payloadJson String
  capturedAt  DateTime @default(now())

  @@unique([shop, periodDays, fingerprint])
  @@index([shop, periodDays, capturedAt])
}

model ProfitMonitorAlert {
  id                String                    @id @default(cuid())
  shop              String
  periodDays        Int
  alertKey          String
  alertType         String
  productId         String?
  status            String                    @default("new")
  isRead            Boolean                   @default(false)
  severity          String
  category          String
  title             String
  description       String
  monthlyImpact     Float                     @default(0)
  economicKind      String
  priority          Int                       @default(0)
  actionLabel       String
  route             String
  businessAction    String
  effort            String
  estimatedMinutes  Int                       @default(0)
  recommendedModule String
  productTitle      String?
  metadataJson      String?
  firstSeenAt       DateTime                  @default(now())
  lastSeenAt        DateTime                  @default(now())
  acknowledgedAt    DateTime?
  resolvedAt        DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  events            ProfitMonitorAlertEvent[]

  @@unique([shop, periodDays, alertKey])
  @@index([shop, periodDays, status])
}

model ProfitMonitorAlertEvent {
  id         String             @id @default(cuid())
  alertId    String
  fromStatus String?
  toStatus   String
  source     String
  createdAt  DateTime           @default(now())
  alert      ProfitMonitorAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([alertId, createdAt])
}
